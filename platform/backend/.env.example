APP_ENV=development
APP_NAME=AI Requirement Hub API
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8001
FRONTEND_ORIGIN=http://localhost:4173

# accounts = normal requester registration and reviewer login.
# test_switch = local development only; the frontend can switch roles without a password.
AUTH_MODE=accounts
# Change AUTH_SECRET_KEY before any non-local deployment.
AUTH_SECRET_KEY=development-only-change-before-production
AUTH_TOKEN_TTL_MINUTES=480
# A reviewer account is created on `python scripts/init_db.py` when this password is set.
# Reviewers are never created through the public registration form.
REVIEWER_BOOTSTRAP_NAME=默认评审人
REVIEWER_BOOTSTRAP_USERNAME=reviewer
REVIEWER_BOOTSTRAP_PASSWORD=

# local_api = local platform + cloud model API
# intranet_api = local platform + internal model gateway
# offline = local model stack, no external API dependency
RUNTIME_MODE=local_api

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
# 默认模型：中文业务文档、澄清、画像、普通方案。
LLM_MODEL=deepseek-v4-flash
# 高质量兜底：高级方案生成或特别复杂需求，不作为全站默认。
LLM_QUALITY_MODEL=deepseek-v4-pro
# 单次调用超时，单位秒。
LLM_TIMEOUT_SECONDS=30
# 长文档整理单独使用更长超时；4 份方案会并发生成。
LLM_DOCUMENT_TIMEOUT_SECONDS=90
LLM_API_KEY=

EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

RERANK_PROVIDER=siliconflow
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

RAGFLOW_ENABLED=false
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
RAGFLOW_TIMEOUT_SECONDS=30

KNOWLEDGE_LOCAL_PATH=../../knowledge
# 评审人上传的知识资料保存目录，第一版使用本地文件检索，不依赖 RAGFlow。
KNOWLEDGE_UPLOAD_DIR=data/knowledge
KNOWLEDGE_SIMILARITY_THRESHOLD=0.72
KNOWLEDGE_PAGE_SIZE=8
KNOWLEDGE_MAX_CONTEXT_CHARS=12000

# 上传材料落盘目录和单文件大小上限。
UPLOAD_DIR=data/uploads
UPLOAD_MAX_SIZE_MB=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_requirement_hub
DB_USER=reqhub_app
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
