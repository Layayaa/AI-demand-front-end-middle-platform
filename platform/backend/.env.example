APP_ENV=development
APP_NAME=AI Requirement Hub API
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# local_api = local platform + cloud model API
# intranet_api = local platform + internal model gateway
# offline = local model stack, no external API dependency
RUNTIME_MODE=local_api

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

EMBEDDING_PROVIDER=siliconflow
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

RERANK_PROVIDER=siliconflow
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

RAGFLOW_ENABLED=false
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT_SECONDS=30

KNOWLEDGE_LOCAL_PATH=../../knowledge
KNOWLEDGE_SIMILARITY_THRESHOLD=0.72
KNOWLEDGE_PAGE_SIZE=8
KNOWLEDGE_MAX_CONTEXT_CHARS=12000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_requirement_hub
DB_USER=reqhub_app
DB_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

